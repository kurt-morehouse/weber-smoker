# Where the Pi is. The one place to change it: deploy.sh, start.sh and the
# backend all read this file. An environment variable of the same name
# overrides a value here for one run, e.g.  SMOKER_PI_HOST=192.168.1.50 ./start.sh
#
# Plain KEY=value lines only (no spaces around =, no quotes needed).

# Hostname or IP address. "raspberrypi" works if your router or mDNS resolves
# it; otherwise try raspberrypi.local or the Pi's IP address.
SMOKER_PI_HOST=raspberrypi

# Login user on the Pi (ssh SMOKER_PI_USER@SMOKER_PI_HOST)
SMOKER_PI_USER=pi

# Project folder on the Pi, relative to that user's home (~/smoker)
SMOKER_PI_DIR=smoker

# The Pi's live WebSocket port (websocket.port in control/config.yaml)
SMOKER_PI_PORT=8765
