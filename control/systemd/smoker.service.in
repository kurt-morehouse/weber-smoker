# Template: install_service.sh fills in @USER@ (whoever runs it) and
# @CONTROL_DIR@ (the folder it's in) and installs the result as
# /etc/systemd/system/smoker.service. Nothing here names a user or path.
[Unit]
Description=Weber smoker controller (preflight, then main.py)
After=network-online.target bluetooth.target
Wants=network-online.target

[Service]
Type=simple
User=@USER@
WorkingDirectory=@CONTROL_DIR@
ExecStartPre=@CONTROL_DIR@/.venv/bin/python preflight.py
ExecStart=@CONTROL_DIR@/.venv/bin/python main.py
# main.py turns both relays off on SIGTERM before it exits. If it was killed
# outright, ExecStopPost still forces both relay pins low.
ExecStopPost=@CONTROL_DIR@/.venv/bin/python tools/relays_off.py
KillSignal=SIGTERM
TimeoutStopSec=15
Restart=always
RestartSec=15
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
